{
  "name": "dsh-workspace-guard",
  "version": "0.2.0",
  "description": "Restore compatibility between Purge and DSH Workspace mode",
  "license": "GPL-3.0-or-later",
  "bin": {
    "dsh-workspace-guard": "./lib/cli.js"
  },
  "files": [
    "lib",
    "src/**/*.ts",
    "build/*.mjs",
    "build/upstream-lock.json",
    "build/source-lock.json",
    "tsconfig.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./sandbox": "./lib/sandbox.js",
    "./policy": "./lib/policy.js",
    "./approval": "./lib/approval.js",
    "./permission": "./lib/permission.js",
    "./fs": "./lib/fs.js",
    "./tools": "./lib/tools.js",
    "./tool-bash": "./lib/tool-bash.js",
    "./tool-pwsh": "./lib/tool-pwsh.js",
    "./tool-fs": "./lib/tool-fs.js",
    "./plugin-tools": "./lib/plugin-tools.js",
    "./permission-bridge": "./lib/permission-bridge.js",
    "./purge-permission": "./lib/purge-permission.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "format": "oxfmt src/*.ts",
    "build:release": "node build/verify-upstream.mjs && tsdown && node build/provenance.mjs",
    "source:release": "node build/source-release.mjs",
    "lint": "oxlint src build tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "upstream:refresh": "node build/verify-upstream.mjs --refresh"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-hmr": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell-env": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
